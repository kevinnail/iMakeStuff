{
  "expo": {
    "name": "iMakeStuff",
    "slug": "imakestuff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "imakestuff",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kevinnail.imakestuff",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      ["expo-dev-client", { "toolsButton": false }],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow iMakeStuff to take a photo of each piece you finish.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow iMakeStuff to save the photos you take to your camera roll.",
          "photosPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dbe1714c-51bb-4393-b9e9-af43018d87ae"
      }
    },
    "owner": "kevinnail"
  }
}
